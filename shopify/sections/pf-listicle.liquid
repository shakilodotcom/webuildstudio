:center}.pfl-callout__text{font-size:clamp(18px,1.8vw,22px);line-height:1.45;font-weight:600;color:var(--pfl-ink)}.pfl-callout svg{margin:12px auto 0;color:var(--pfl-accent)}.pfl-offer{background:var(--pfl-offer-bg,#f6f7fb);padding:clamp(40px,5.5vw,72px) 20px}.pfl-offer__inner{max-width:1040px;margin:0 auto;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(24px,3.5vw,48px);align-items:start}@media(max-width:899px){.pfl-offer__inner{grid-template-columns:minmax(0,1fr);max-width:640px}}@media(min-width:900px){.pfl-gal--sticky{position:sticky;top:var(--pfl-sticky-top,24px)}}.pfl-gal__main{position:relative;aspect-ratio:1/1;background:var(--pfl-gal-bg,#f5f3fe);border:1px solid #e7e9f0;border-radius:20px;overflow:hidden}.pfl-gal__slide{position:absolute;top:0;right:0;bottom:0;left:0}.pfl-gal__slide img,.pfl-gal__slide video,.pfl-gal__slide iframe,.pfl-gal__slide svg{width:100%;height:100%;object-fit:var(--pfl-gal-fit,contain);border:0}.pfl-gal__arrow{position:absolute;top:50%;transform:translateY(-50%);z-index:2;width:40px;height:40px;border-radius:50%;border:0;background:#ffffffeb;box-shadow:0 4px 14px #0b2e5926;cursor:pointer;display:flex;align-items:center;justify-content:center;padding:0;color:var(--pfl-ink)}.pfl-gal__arrow--prev{left:12px}.pfl-gal__arrow--next{right:12px}.pfl-gal__thumbs{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px;margin-top:12px}.pfl-gal__thumb{padding:0;border-radius:12px;overflow:hidden;border:2px solid #e7e9f0;background:#fff;cursor:pointer;aspect-ratio:1/1}.pfl-gal__thumb.is-active{border-color:var(--pfl-navy)}.pfl-gal__thumb img{width:100%;height:100%;object-fit:cover}.pfl-buy{background:#fff;border:1px solid #e7e9f0;border-radius:20px;padding:clamp(18px,2.6vw,32px)}.pfl-pill{display:inline-block;background:#eef3fb;color:var(--pfl-navy);font-size:13px;font-weight:500;line-height:1.4;padding:6px 12px;border-radius:999px}.pfl-pill strong,.pfl-pill b{font-weight:700;color:#a34503}.pfl .pfl-buy__title