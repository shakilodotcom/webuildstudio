{% comment %}
  PF listicle page: the full knee-sleeve listicle as one section.
  Product data (gallery, variants, price, sticky bar image, cart form) comes from the
  product picked in the section settings. Copy, review images and videos are static below.
{% endcomment %}
{%- assign product = section.settings.product | default: product -%}
{%- if product == blank and request.design_mode -%}
  <p style="padding:40px 20px;text-align:center;font-family:sans-serif">Pick a product in this section's settings.</p>
{%- endif -%}
{%- assign current_variant = product.selected_or_first_available_variant -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400;1,500&display=swap" rel="stylesheet">
<style>
.shopify-section-group-header-group,.shopify-section-group-footer-group{display:none !important}
/* Page base: reset + typography the listicle sections inherit. */
html {
  box-sizing: border-box;
  height: 100%;
  font-size: 10px;
}

*,
*::before,
*::after {
  box-sizing: inherit;
}

body {
  display: grid;
  grid-template-columns: 100%;
  min-height: 100%;
  margin: 0;
  overflow-x: hidden;
  background: #fff;
  color: rgba(18, 18, 18, 0.9);
  font-family: Poppins, sans-serif;
  font-size: 15px;
  line-height: 1.8;
  letter-spacing: 0.06em;
}

@media (min-width: 750px) {
  body {
    font-size: 16px;
  }
}

h1,
h2,
h3 {
  word-break: break-word;
}

a {
  text-decoration: none;
}

img,
video {
  vertical-align: bottom;
}

img {
  max-width: 100%;
}

button {
  color: rgb(18, 18, 18);
}

summary {
  position: relative;
}

.product-form__submit {
  font-size: 19px;
}

.hidden {
  display: none !important;
}

div:empty {
  display: none;
}
