{%- comment -%}
  Vitals reviews for any template (pages, landing pages, home).
  Shows the first 20 reviews of the chosen product by reading the same
  JSON the Vitals widget loads on product pages.
  Needs the Vitals app embed switched on (Theme settings > App embeds).
{%- endcomment -%}

{%- assign p = section.settings.product -%}
{%- if p != blank -%}
  {%- assign rating = p.metafields.reviews.rating.value.rating | default: 0 -%}
  {%- assign count = p.metafields.reviews.rating_count.value | default: 0 -%}
  {%- assign pct = rating | times: 20 -%}

  <section
    class="vr"
    id="vr-{{ section.id }}"
    data-shop-id="{{ shop.id }}"
    data-product-id="{{ p.id }}"
    data-cache-key="{{ section.settings.cache_key | strip }}"
    data-show-photos="{{ section.settings.show_photos }}"
    style="--vr-star: {{ section.settings.star_color }};"
  >
    <div class="vr__head">
      {%- if section.settings.heading != blank -%}
        <h2 class="vr__title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if count > 0 -%}
        <div class="vr__summary" aria-label="{{ rating }} out of 5 stars, {{ count }} reviews">
          <span class="vr__stars"><span class="vr__stars-fill" style="width: {{ pct }}%">★★★★★</span>★★★★★</span>
          <span class="vr__summary-text">{{ rating }} · {{ count }} reviews</span>
        </div>
      {%- endif -%}
    </div>

    <div class="vr__grid" data-vr-grid aria-live="polite"></div>
  </section>

  <style>
    #vr-{{ section.id }} { max-width: 1200px; margin: 0 auto; padding: 48px 16px; }
    #vr-{{ section.id }} .vr__head { text-align: center; margin-bottom: 28px; }
    #vr-{{ section.id }} .vr__title { margin: 0 0 8px; }
    #vr-{{ section.id }} .vr__summary { display: inline-flex; align-items: center; gap: 8px; font-size: 15px; }
    #vr-{{ section.id }} .vr__stars { position: relative; display: inline-block; color: #e5e7eb; letter-spacing: 2px; white-space: nowrap; }
    #vr-{{ section.id }} .vr__stars-fill { position: absolute; inset: 0 auto 0 0; overflow: hidden; color: var(--vr-star); }
    #vr-{{ section.id }} .vr__grid { columns: 3 280px; column-gap: 16px; }
    #vr-{{ section.id }} .vr__card { break-inside: avoid; margin: 0 0 16px; background: #fff; border: 1px solid rgba(0,0,0,.08); border-radius: 14px; overflow: hidden; box-shadow: 0 6px 16px rgba(0,0,0,.04); }
    #vr-{{ section.id }} .vr__photo { display: block; width: 100%; height: auto; background: #f3f4f6; }
    #vr-{{ section.id }} .vr__body { padding: 14px 16px 16px; }
    #vr-{{ section.id }} .vr__card-stars { color: var(--vr-star); letter-spacing: 1px; font-size: 14px; }
    #vr-{{ section.id }} .vr__text { margin: 8px 0 10px; font-size: 14px; line-height: 1.45; color: rgba(0,0,0,.78); }
    #vr-{{ section.id }} .vr__meta { display: flex; justify-content: space-between; font-size: 13px; color: rgba(0,0,0,.55); }
    #vr-{{ section.id }} .vr__name { font-weight: 600; color: rgba(0,0,0,.85); }
    #vr-{{ section.id }} .vr__reply { margin-top: 10px; padding: 10px 12px; border-radius: 10px; background: #f9fafb; font-size: 13px; }
  </style>

  <script>
    (function () {
      var root = document.getElementById('vr-{{ section.id }}');
      if (!root) return;
      var grid = root.querySelector('[data-vr-grid]');
      var shopId = root.dataset.shopId;
      var productId = root.dataset.productId;
      var showPhotos = root.dataset.showPhotos === 'true';

      // Vitals changes this key whenever reviews change. Use the setting if
      // filled in, otherwise try the keys the Vitals app embed puts on every page.
      function cacheKeys() {
        if (root.dataset.cacheKey) return [root.dataset.cacheKey];
        var keys = ((window.vtlsLiquidData || {}).cacheKeys || []).filter(Boolean);
        return keys.filter(function (k, i) { return keys.indexOf(k) === i; })
          .sort(function (a, b) { return b - a; });
      }

      function load(keys) {
        if (!keys.length) return Promise.reject(new Error('No Vitals cache key found'));
        var url = 'https://appsolve.io/bundle/api/v2/sf/pr/prd/' + keys[0] + '/p1/' + productId + '.json';
        return fetch(url)
          .then(function (r) { return r.ok ? r.json() : Promise.reject(); })
          .then(function (data) { return data && data.reviews ? data : Promise.reject(); })
          .catch(function () { return load(keys.slice(1)); });
      }

      function esc(s) {
        var d = document.createElement('div');
        d.textContent = s == null ? '' : String(s);
        return d.innerHTML;
      }

      function photoUrl(reviewId, photo) {
        return 'https://cdn-pri.vitals.app/phrev/' + shopId + '/640/' + reviewId + '-' + String(photo).replace(/^vitals\./, '') + '.jpg';
      }

      function render(reviews) {
        grid.innerHTML = reviews.slice(0, 20).map(function (r) {
          var photo = showPhotos && r.photos && r.photos.length
            ? '<img class="vr__photo" loading="lazy" alt="Photo from ' + esc(r.name) + '" src="' + photoUrl(r.id, r.photos[0]) + '"' +
              (r.imgWidth ? ' width="' + r.imgWidth + '" height="' + r.imgHeight + '"' : '') + '>'
            : '';
          var stars = '★★★★★'.slice(0, r.stars) + '<span style="color:#e5e7eb">' + '★★★★★'.slice(r.stars) + '</span>';
          var date = r.date ? new Date(r.date).toLocaleDateString(undefined, { day: 'numeric', month: 'short', year: 'numeric' }) : '';
          return '<article class="vr__card">' + photo +
            '<div class="vr__body">' +
              '<div class="vr__card-stars" aria-label="' + r.stars + ' out of 5 stars">' + stars + '</div>' +
              '<p class="vr__text">' + esc(r.review) + '</p>' +
              '<div class="vr__meta"><span class="vr__name">' + esc(r.name) + '</span><span>' + esc(date) + '</span></div>' +
              (r.reply ? '<div class="vr__reply"><strong>{{ shop.name | escape }}:</strong> ' + esc(r.reply) + '</div>' : '') +
            '</div></article>';
        }).join('');
      }

      load(cacheKeys())
        .then(function (data) { render(data.reviews); })
        .catch(function () { grid.hidden = true; });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Vitals reviews",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What customers are saying" },
    { "type": "color", "id": "star_color", "label": "Star colour", "default": "#FFD700" },
    { "type": "checkbox", "id": "show_photos", "label": "Show review photos", "default": true },
    {
      "type": "text",
      "id": "cache_key",
      "label": "Vitals cache key (optional)",
      "info": "Leave empty. Only fill in if reviews don't load: copy the number after /prd/ from the reviews request on the product page."
    }
  ],
  "presets": [{ "name": "Vitals reviews" }]
}
{% endschema %}
