{%- comment -%}
  "Roasted in Small Batches with Big Standards": centred heading, proof
  points split either side of a red-framed video with a rolling batch-code
  tag. Points are blocks; the first half sit left, the rest right.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign point_count = section.blocks.size
  assign left_count = point_count | plus: 1 | divided_by: 2
-%}

<section class="heist-quality heist-paper" id="HeistQuality-{{ section.id }}">
  <div class="heist-grain" aria-hidden="true"></div>
  <div class="heist-container">
    <h2 class="heist-quality__heading t-h4">{{ s.heading }}</h2>

    <div class="heist-quality__layout">
      <ul class="heist-quality__column heist-quality__column--left" role="list">
        {%- for block in section.blocks limit: left_count -%}
          <li class="heist-quality__point t-h7" {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
        {%- endfor -%}
      </ul>

      <div class="heist-quality__media">
        {%- if s.code != blank -%}
          <p class="heist-quality__code t-n2" data-heist-roller data-value="{{ s.code | escape }}" aria-label="{{ s.code_label | escape }} {{ s.code | escape }}">
            {{ s.code }}
          </p>
        {%- endif -%}
        <div class="heist-quality__frame">
          {% render 'heist-media',
            video: s.video,
            image: s.image,
            class: 'heist-quality__video',
            sizes: '(max-width: 749px) 92vw, 28vw',
            placeholder: 'lifestyle-2',
            label: 'Roasting film'
          %}
        </div>
      </div>

      <ul class="heist-quality__column heist-quality__column--right" role="list">
        {%- for block in section.blocks offset: left_count -%}
          <li class="heist-quality__point t-h7" {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Heist quality points",
  "class": "heist-quality-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Roasted in Small Batches with Big Standards"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "Portrait, about 4:5."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Poster / fallback image"
    },
    {
      "type": "text",
      "id": "code",
      "label": "Batch code tag",
      "info": "Digits roll into place when the section scrolls into view.",
      "default": "23587 1348 124"
    },
    {
      "type": "text",
      "id": "code_label",
      "label": "Batch code description",
      "default": "Batch"
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Proof point",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Top 1% of World’s Coffee Beans"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Heist quality points",
      "blocks": [
        { "type": "point" },
        { "type": "point" }
      ]
    }
  ]
}
{% endschema %}
