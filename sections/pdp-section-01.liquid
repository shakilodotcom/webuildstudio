{%- liquid
  if p != blank
    assign cv = p.selected_or_first_available_variant
    assign has_plan = false
    if section.settings.show_subscription and p.selling_plan_groups.size > 0
      assign plan = p.selling_plan_groups.first.selling_plans.first
      assign has_plan = true
    endif
    assign start_sub = false
    if has_plan
      if section.settings.subscribe_by_default or p.requires_selling_plan
        assign start_sub = true
      endif
    endif
  endif
-%}

<section id="{{ sid }}" class="pdp-product{% if start_sub %} is-sub{% endif %}">
  <span id="pdp-product" style="position: relative; top: -80px; display: block; height: 0" aria-hidden="true"></span>
  {%- if p == blank -%}
    <p class="pdp-empty">Pick a product for this section in the theme editor.</p>
  {%- else -%}
    <div class="pdp-grid">
      {%- comment -%} Gallery: image URLs from the "Gallery image URLs" setting when filled in, otherwise the product's media. {%- endcomment -%}
      {%- liquid
        assign ext = ''
        assign lines = section.settings.gallery_image_urls | newline_to_br | split: '<br />'
        for l in lines
          assign u = l | strip
          if u != blank
            assign ext = ext | append: u | append: '||'
          endif
        endfor
        assign ext = ext | split: '||'
      -%}
      <pdp-gallery>
        <div class="pdp-main" data-main>
          {%- assign shown = 0 -%}
          {%- for u in ext -%}
            {%- if u contains '?' -%}{%- assign sep = '&' -%}{%- else -%}{%- assign sep = '?' -%}{%- endif -%}
            <div class="pdp-slide" data-slide {% if shown > 0 %}hidden{% endif %}>
              {%- if u contains '.gif' -%}
                <img src="{{ u }}" width="1200" height="1200" loading="{% if shown == 0 %}eager{% else %}lazy{% endif %}" alt="{{ p.title | escape }}">
              {%- else -%}
              <img src="{{ u }}{{ sep }}width=1200" srcset="{{ u }}{{ sep }}width=400 400w, {{ u }}{{ sep }}width=600 600w, {{ u }}{{ sep }}width=800 800w, {{ u }}{{ sep }}width=1000 1000w, {{ u }}{{ sep }}width=1200 1200w" sizes="(min-width: 769px) 50vw, 100vw" width="1200" height="1200" loading="{% if shown == 0 %}eager{% else %}lazy{% endif %}" alt="{{ p.title | escape }}">
              {%- endif -%}
            </div>
            {%- assign shown = shown | plus: 1 -%}
          {%- endfor -%}
          {%- for m in p.media -%}
            {%- if ext.size > 0 -%}{%- break -%}{%- endif -%}
            {%- if m.media_type == 'image' -%}
              <div class="pdp-slide" data-slide data-media-id="{{ m.id }}" {% if shown > 0 %}hidden{% endif %}>
                {%- if shown == 0 -%}{%- assign ld = 'eager' -%}{%- else -%}{%- assign ld = 'lazy' -%}{%- endif -%}
                {{ m | image_url: width: 1200 | image_tag: widths: '400, 600, 800, 1000, 1200', sizes: '(min-width: 769px) 50vw, 100vw', loading: ld, alt: m.alt | default: p.title }}
              </div>
              {%- assign shown = shown | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if shown == 0 -%}
            <div class="pdp-slide" data-slide>{{ 'product-1' | placeholder_svg_tag }}</div>
          {%- endif -%}
          {%- if shown > 1 -%}
            <button type="button" class="pdp-gprev" data-prev aria-label="Previous image"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#999" stroke-width="1.6" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg></button>
            <button type="button" class="pdp-gnext" data-next aria-label="Next image"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="1.6" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
          {%- endif -%}
        </div>
        {%- if shown > 1 -%}
          <div class="pdp-thumbs">
            {%- assign t = 0 -%}
            {%- for u in ext -%}
              {%- if u contains '?' -%}{%- assign sep = '&' -%}{%- else -%}{%- assign sep = '?' -%}{%- endif -%}
              <button type="button" data-thumb="{{ t }}" aria-label="Show image {{ t | plus: 1 }}" aria-current="{% if t == 0 %}true{% else %}false{% endif %}">
                <img src="{{ u }}{% unless u contains '.gif' %}{{ sep }}width=300{% endunless %}" width="300" height="300" loading="lazy" alt="">
              </button>
              {%- assign t = t | plus: 1 -%}
            {%- endfor -%}
            {%- for m in p.media -%}
              {%- if ext.size > 0 -%}{%- break -%}{%- endif -%}
              {%- if m.media_type == 'image' -%}
                <button type="button" data-thumb="{{ t }}" aria-label="Show image {{ t | plus: 1 }}" aria-current="{% if t == 0 %}true{% else %}false{% endif %}">
                  {{ m | image_url: width: 300 | image_tag: loading: 'lazy', alt: '' }}
                </button>
                {%- assign t = t | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </pdp-gallery>

      <div>
        <h2 class="pdp-title">{{ p.title | escape }}</h2>
        {%- if section.settings.rating_text != blank -%}
          <div class="pdp-rating">
            <div class="pdp-stars" role="img" aria-label="{{ section.settings.rating_text | escape }}">
              {%- for i in (1..5) -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3 6.9 7.5.6-5.7 4.9 1.8 7.3L12 17.8 5.4 21.7l1.8-7.3L1.5 9.5 9 8.9z"/></svg>{%- endfor -%}
            </div>
            <span>{{ section.settings.rating_text | escape }}</span>
          </div>
        {%- endif -%}

        <ul class="pdp-benefits">
          {%- for block in section.blocks -%}
            {%- if block.type == 'benefit' -%}
              <li {{ block.shopify_attributes }}><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M7.5 12.5l3 3 6-6.5"/></svg><span>{{ block.settings.text }}</span></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
        {%- if section.settings.note != blank -%}<p class="pdp-note">{{ section.settings.note | escape }}</p>{%- endif -%}

        {%- comment -%} Low-stock headline above the bundle options. [stock] = the variant's real inventory (hidden when not tracked). {%- endcomment -%}
        {%- assign stock_text = section.settings.stock_headline -%}
        {%- if stock_text contains '[stock]' -%}
          {%- if cv.inventory_management == 'shopify' and cv.inventory_quantity > 0 -%}
            {%- assign stock_text = stock_text | replace: '[stock]', cv.inventory_quantity -%}
          {%- else -%}
            {%- assign stock_text = '' -%}
          {%- endif -%}
        {%- endif -%}

        {%- form 'product', p, novalidate: 'novalidate' -%}
          {%- if tier_count > 0 -%}
            {%- comment -%} Bundle tiers (Buy X Get Y Free): one variant, quantity = buy + free. {%- endcomment -%}
            {%- liquid
              assign sub_unit = cv.price
              if has_plan
                for a in cv.selling_plan_allocations
                  if a.selling_plan.id == plan.id
                    assign sub_unit = a.price
                  endif
                endfor
              endif
              assign cmp_unit = cv.compare_at_price | default: cv.price
              if cmp_unit < cv.price
                assign cmp_unit = cv.price
              endif
              assign start_qty = 1
            -%}
            <input type="hidden" name="id" value="{{ cv.id }}">
            {%- if stock_text != blank -%}<p class="pdp-div">{{ stock_text | escape }}</p>{%- endif -%}
            <fieldset>
              <legend>{{ section.settings.options_legend | escape }}</legend>
              {%- for i in (1..tier_count) -%}
                {%- liquid
                  if use_default_tiers
                    assign buy = i
                    assign qty = i | times: 2
                    assign t_title = 'Buy ' | append: i | append: ' Get ' | append: i | append: ' Free'
                    assign t_sub = ''
                    assign t_attrs = ''
                  else
                    assign block = tiers[forloop.index0]
                    assign buy = block.settings.buy_qty
                    assign qty = buy | plus: block.settings.get_qty
                    assign t_title = block.settings.title
                    assign t_sub = block.settings.subtitle
                    assign t_attrs = block.shopify_attributes
                  endif
                  assign price_otp = cv.price | times: buy
                  assign price_sub = sub_unit | times: buy
                  assign price_cmp = cmp_unit | times: qty
                  if forloop.index == default_pos
                    assign start_qty = qty
                  endif
                -%}
                <label class="pdp-opt{% unless cv.available %} is-unavailable{% endunless %}" {{ t_attrs }}>
                  <input type="radio" name="pdp-tier-{{ section.id }}" value="{{ qty }}" data-tier="{{ qty }}" {% if forloop.index == default_pos %}checked{% endif %} {% unless cv.available %}disabled{% endunless %}>
                  <span class="pdp-nm">
                    <b>{{ t_title | escape }}</b>
                    {%- if t_sub != blank -%}
                      {%- assign pct = 0 -%}
                      {%- if price_cmp > price_otp -%}{%- assign pct = price_cmp | minus: price_otp | times: 100 | divided_by: price_cmp -%}{%- endif -%}
                      <span>{{ t_sub | replace: '[percent]', pct | escape }}</span>
                    {%- endif -%}
                  </span>
                  <span class="pdp-pr">
                    <b class="pdp-p1">{{ price_otp | money }}</b>
                    {%- if has_plan -%}<b class="pdp-p2">{{ price_sub | money }}</b>{%- endif -%}
                    {%- if price_cmp > price_otp -%}<s>{{ price_cmp | money }}</s>{%- endif -%}
                  </span>
                  {%- if section.settings.badge_text != blank and forloop.index == section.settings.badge_position -%}
                    <span class="pdp-badge">{{ section.settings.badge_text | escape }}</span>
                  {%- endif -%}
                </label>
              {%- endfor -%}
            </fieldset>
            <input type="hidden" name="quantity" value="{{ start_qty }}" data-qty-input>
          {%- elsif p.has_only_default_variant -%}
            <input type="hidden" name="id" value="{{ cv.id }}">
            {%- if stock_text != blank -%}<p class="pdp-div">{{ stock_text | escape }}</p>{%- endif -%}
          {%- else -%}
            {%- if stock_text != blank -%}<p class="pdp-div">{{ stock_text | escape }}</p>{%- endif -%}
            <fieldset>
              <legend>{{ section.settings.options_legend | escape }}</legend>
              {%- for v in p.variants -%}
                {%- liquid
                  assign v_sub = v.price
                  if has_plan
                    for a in v.selling_plan_allocations
                      if a.selling_plan.id == plan.id
                        assign v_sub = a.price
                      endif
                    endfor
                  endif
                -%}
                <label class="pdp-opt{% unless v.available %} is-unavailable{% endunless %}">
                  <input type="radio" name="id" value="{{ v.id }}" {% if forloop.index == default_pos %}checked{% endif %} {% unless v.available %}disabled{% endunless %} {% if v.featured_media %}data-media-id="{{ v.featured_media.id }}"{% endif %}>
                  <span class="pdp-nm">
                    <b>{{ v.title | escape }}</b>
                    {%- if v.compare_at_price > v.price -%}
                      {%- assign pct = v.compare_at_price | minus: v.price | times: 100 | divided_by: v.compare_at_price -%}
                      <span>{{ section.settings.savings_label | replace: '[percent]', pct }}</span>
                    {%- endif -%}
                  </span>
                  <span class="pdp-pr">
                    <b class="pdp-p1">{{ v.price | money }}</b>
                    {%- if has_plan -%}<b class="pdp-p2">{{ v_sub | money }}</b>{%- endif -%}
                    {%- if v.compare_at_price > v.price -%}<s>{{ v.compare_at_price | money }}</s>{%- endif -%}
                  </span>
                  {%- if section.settings.badge_text != blank and forloop.index == section.settings.badge_position -%}
                    <span class="pdp-badge">{{ section.settings.badge_text | escape }}</span>
                  {%- endif -%}
                </label>
              {%- endfor -%}
            </fieldset>
          {%- endif -%}

          {%- if has_plan -%}
            {%- comment -%} Subscribe & Save (first selling plan of the product's first selling plan group). {%- endcomment -%}
            {%- if section.settings.sub_heading != blank -%}<p class="pdp-div">{{ section.settings.sub_heading | escape }}</p>{%- endif -%}
            <fieldset>
              <legend>{{ section.settings.sub_heading | default: 'Purchase option' | escape }}</legend>
              {%- unless p.requires_selling_plan -%}
                <label class="pdp-opt pdp-plan">
                  <input type="radio" name="pdp-plan-{{ section.id }}" value="" data-plan {% unless start_sub %}checked{% endunless %}>
                  <span class="pdp-nm">
                    <b>{{ section.settings.one_time_title | escape }}</b>
                    {%- if section.settings.one_time_subtitle != blank -%}<span>{{ section.settings.one_time_subtitle | escape }}</span>{%- endif -%}
                  </span>
                </label>
              {%- endunless -%}
              <label class="pdp-opt pdp-plan">
                <input type="radio" name="pdp-plan-{{ section.id }}" value="{{ plan.id }}" data-plan {% if start_sub %}checked{% endif %}>
                <span class="pdp-nm">
                  <b>{{ section.settings.sub_title | escape }}</b>
                  {%- if section.settings.sub_subtitle != blank -%}<span>{{ section.settings.sub_subtitle | escape }}</span>{%- endif -%}
                </span>
                {%- assign hl = section.settings.sub_highlights | newline_to_br | split: '<br />' -%}
                {%- if section.settings.sub_highlights != blank -%}
                  <ul class="pdp-hl">
                    {%- for h in hl -%}
                      {%- assign h = h | strip -%}
                      {%- if h != blank -%}
                        <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20.3s-8-4.7-8-10.6A4.6 4.6 0 0 1 12 6.6a4.6 4.6 0 0 1 8 3.1c0 5.9-8 10.6-8 10.6z"/></svg>{{ h | escape }}</li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </label>
            </fieldset>
            <input type="hidden" name="selling_plan" value="{{ plan.id }}" data-plan-input {% unless start_sub %}disabled{% endunless %}>
          {%- endif -%}

          <button type="submit" name="add" class="pdp-atc" {% unless p.available %}disabled{% endunless %}>
            {%- if p.available -%}{{ section.settings.atc_label | escape }}{%- else -%}{{ section.settings.soldout_label | escape }}{%- endif -%}
          </button>
        {%- endform -%}

        <div class="pdp-acc">
          {%- for block in section.blocks -%}
            {%- if block.type == 'collapsible' -%}
              <details {{ block.shopify_attributes }} {% if block.settings.open %}open{% endif %}>
                <summary>{{ block.settings.heading | escape }}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 9l7 7 7-7"/></svg></summary>
                <div class="pdp-bd">
                  {%- if block.settings.use_description -%}{{ p.description }}{%- endif -%}
                  {{ block.settings.content }}
                  {%- if block.settings.popup_label != blank and block.settings.popup_content != blank -%}
                    <button type="button" class="pdp-popbtn" data-open-dialog="dlg-{{ block.id }}">{{ block.settings.popup_label | escape }}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M8 6h12M8 12h12M8 18h12M4 6h.01M4 12h.01M4 18h.01"/></svg></button>
                    <dialog id="dlg-{{ block.id }}" aria-label="{{ block.settings.popup_label | escape }}">
                      <button type="button" class="pdp-x" data-close-dialog aria-label="Close"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="1.8" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
                      {{ block.settings.popup_content }}
                    </dialog>
                  {%- endif -%}
                </div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <div class="pdp-badges">
          {%- for block in section.blocks -%}
            {%- if block.type == 'badge' -%}
              <div {{ block.shopify_attributes }}>
                {%- if block.settings.icon != blank -%}
                  {{ block.settings.icon | image_url: width: 140 | image_tag: loading: 'lazy', alt: '' }}
                {%- else -%}
                  {%- assign bl = block.settings.label | downcase -%}
                  <svg class="pdp-bi" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    {%- if bl contains 'risk' or bl contains 'trial' or bl contains 'guarantee' or bl contains 'return' -%}
                      <rect x="3.5" y="5" width="17" height="15" rx="2.5"/><path d="M3.5 10h17M8 3v4M16 3v4"/><path d="M8.6 15.2l2.4 2.3 4.6-4.8"/>
                    {%- elsif bl contains 'melanin' or bl contains 'skin tone' or bl contains 'all skin' -%}
                      <circle cx="12" cy="13.2" r="6.4"/><path d="M9.8 12.6v.01M14.2 12.6v.01" stroke-width="2.2"/><path d="M9.6 15.6c1.4 1.5 3.4 1.5 4.8 0"/><path d="M12 2.6v2M5.3 5.3l1.4 1.4M18.7 5.3l-1.4 1.4M2.6 12.2h2M19.4 12.2h2"/>
                    {%- elsif bl contains 'needle' -%}
                      <circle cx="12" cy="12" r="9.6"/><g transform="rotate(-45 12 12) translate(.5 0)"><rect x="8" y="10" width="8" height="4" rx=".8"/><path d="M8 12H4.2M16 12h3M19 9.6v4.8M8 10v4M10.4 10v1.3M12.4 10v1.3M14.4 10v1.3"/></g><path d="M5.2 5.2l13.6 13.6"/>
                    {%- elsif bl contains 'sensitive' or bl contains 'gentle' or bl contains 'safe' -%}
                      <path d="M12 3l7.5 2.8v5.6c0 4.4-3.1 8-7.5 9.6-4.4-1.6-7.5-5.2-7.5-9.6V5.8z"/><path d="M12 15.6s-3.4-2-3.4-4.5a1.9 1.9 0 0 1 3.4-1.2 1.9 1.9 0 0 1 3.4 1.2c0 2.5-3.4 4.5-3.4 4.5z"/>
                    {%- elsif bl contains 'white cast' or bl contains 'cast' -%}
                      <path d="M10 3.5s5.5 5.7 5.5 9.6a5.5 5.5 0 0 1-11 0C4.5 9.2 10 3.5 10 3.5z"/><path d="M7.6 13.6a2.6 2.6 0 0 0 2.5 2.5"/><path d="M18.5 3.5l.7 1.8 1.8.7-1.8.7-.7 1.8-.7-1.8-1.8-.7 1.8-.7z"/>
                    {%- else -%}
                      <path d="M11 3.2c-3.6 0-6 2.8-6 6.8 0 4.6 2.6 9.8 6 9.8 1.2 0 2.3-.7 3.2-1.8"/><path d="M11 3.2c3.6 0 6 2.8 6 6.8"/><path d="M8.6 10v.01M13.4 10v.01" stroke-width="2"/><circle class="pdp-bi-bg" cx="17.4" cy="17.4" r="4"/><path d="M15.5 17.4l1.3 1.3 2.4-2.6"/>
                    {%- endif -%}
                  </svg>
                {%- endif -%}
                {{ block.settings.label | escape }}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}
</section>

<script>
  (function () {
    if (!customElements.get('pdp-gallery')) {
      class PdpGallery extends HTMLElement {
        connectedCallback() {
          this.slides = Array.from(this.querySelectorAll('[data-slide]'));
          this.thumbs = Array.from(this.querySelectorAll('[data-thumb]'));
          this.index = 0;
          var prev = this.querySelector('[data-prev]'), next = this.querySelector('[data-next]'), main = this.querySelector('[data-main]');
          if (prev) prev.addEventListener('click', () => this.show(this.index - 1));
          if (next) next.addEventListener('click', () => this.show(this.index + 1));
          this.thumbs.forEach((t) => t.addEventListener('click', () => this.show(Number(t.dataset.thumb))));
          if (main) {
            var x = null;
            main.addEventListener('pointerdown', (e) => { x = e.clientX; });
            main.addEventListener('pointerup', (e) => {
              if (x === null) return;
              var dx = e.clientX - x; x = null;
              if (Math.abs(dx) > 40) this.show(this.index + (dx < 0 ? 1 : -1));
            });
          }
        }
        show(i) {
          var n = this.slides.length;
          if (!n) return;
          this.index = (i + n) % n;
          this.slides.forEach((s, k) => { s.hidden = k !== this.index; });
          this.thumbs.forEach((t, k) => t.setAttribute('aria-current', k === this.index ? 'true' : 'false'));
          var a = this.thumbs[this.index];
          if (a) a.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'smooth' });
        }
        showMedia(id) {
          var i = this.slides.findIndex((s) => s.dataset.mediaId === String(id));
          if (i > -1) this.show(i);
        }
      }
      customElements.define('pdp-gallery', PdpGallery);
    }

    var root = document.getElementById('{{ sid }}');
    if (!root) return;
    // bundle tier -> cart quantity; Subscribe & Save -> selling_plan (and subscription prices)
    function sync() {
      var tier = root.querySelector('[data-tier]:checked'), qty = root.querySelector('[data-qty-input]');
      if (tier && qty) qty.value = tier.dataset.tier;
      var plan = root.querySelector('[data-plan]:checked'), sp = root.querySelector('[data-plan-input]');
      var sub = !!(plan && plan.value);
      if (sp) sp.disabled = !sub;
      if (root.querySelector('[data-plan]')) root.classList.toggle('is-sub', sub);
    }
    sync();
    window.addEventListener('pageshow', sync);
    root.addEventListener('change', function (e) {
      sync();
      // selecting a bundle shows that variant's image (when the variant has one)
      var id = e.target && e.target.dataset && e.target.dataset.mediaId;
      var g = root.querySelector('pdp-gallery');
      if (id && g && g.showMedia) g.showMedia(id);
    });
    // "Full ingredient list" style popups
    root.addEventListener('click', function (e) {
      var opener = e.target.closest('[data-open-dialog]');
      if (opener) { var d = document.getElementById(opener.dataset.openDialog); if (d && d.showModal) d.showModal(); return; }
      var closer = e.target.closest('[data-close-dialog]');
      if (closer) { var dlg = closer.closest('dialog'); if (dlg) dlg.close(); return; }
      if (e.target.tagName === 'DIALOG') e.target.close();
    });
  })();
</script>

