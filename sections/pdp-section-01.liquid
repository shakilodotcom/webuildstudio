{%- comment -%}
  Section #01 – Product / buy box (Elements of Cho – Hydrogel Eye Recovery Patch)
  Self-contained: styles in the style block below (scoped to this section's id), behaviour in the inline <script>.
  Uses the real Shopify product: images, variants (bundle options), prices and the add-to-cart form.
  Bundle options come from "Bundle tier" blocks (Buy X Get Y, quantity based) when any are added,
  otherwise from the product's variants. Subscribe & Save uses the product's first selling plan.
  Other sections' buttons link here with #pdp-product.
{%- endcomment -%}
{%- liquid
  assign p = section.settings.product
  if p == blank
    assign p = product
  endif
  assign sid = 'pdp-' | append: section.id
  assign tiers = section.blocks | where: 'type', 'tier'
  assign tier_count = tiers.size
  assign use_default_tiers = false
  if p != blank and tier_count == 0 and p.has_only_default_variant
    # no "Bundle tier" blocks on a single-variant product: show Buy 1 Get 1 Free / Buy 2 Get 2 Free
    assign use_default_tiers = true
    assign tier_count = 2
  endif
  assign default_pos = section.settings.default_variant
  if p != blank
    if tier_count > 0
      if default_pos > tier_count
        assign default_pos = 1
      endif
    elsif default_pos > p.variants.size
      assign default_pos = 1
    endif
  endif
  assign accent = section.settings.accent_color
  assign accent_soft = accent | color_modify: 'alpha', 0.35
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Onest:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

